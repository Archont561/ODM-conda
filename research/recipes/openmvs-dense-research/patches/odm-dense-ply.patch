+// ODM research export: scalar view counts, while the regular SavePLY
+// remains unchanged and can preserve full view-index/weight lists.
+bool PointCloud::SaveODMPLY(const String& fileName) const
+{
+    if (IsEmpty() || colors.size() != points.size() || normals.size() != points.size() || pointViews.size() != points.size())
+        return false;
+    for (const auto& views : pointViews) {
+        if (views.empty() || views.size() > 255)
+            return false;
+    }
+    ASSERT(!fileName.empty());
+    Util::ensureFolder(fileName);
+    using namespace PointCloudInternal;
+    PLY ply;
+    if (!ply.write(fileName, 1, BasicPLY::elem_names, PLY::BINARY_LE))
+        return false;
+    BasicPLY::Vertex::InitSaveProps(ply, (int)points.size(), true, true, false, false, false);
+    const PLY::PlyProperty viewCount = {"views", PLY::Uint8, PLY::Uint8, offsetof(BasicPLY::Vertex,views.num), 0, 0, 0, 0};
+    ply.describe_property(BasicPLY::elem_names[0], viewCount);
+    if (!ply.header_complete())
+        return false;
+    BasicPLY::Vertex vertex;
+    FOREACH(i, points) {
+        vertex.p = points[i];
+        vertex.c = colors[i];
+        vertex.n = normals[i];
+        vertex.views.num = static_cast<uint8_t>(pointViews[i].size());
+        ply.put_element(&vertex);
+    }
+    ASSERT(ply.get_current_element_count() == (int)points.size());
+    return true;
+}
