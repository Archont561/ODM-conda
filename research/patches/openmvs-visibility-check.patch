 		else if (OPT::fBorderROI < 0)
 			scene.obb.Enlarge(-OPT::fBorderROI);
 		if (OPT::strMeshFileName.empty() && scene.mesh.IsEmpty()) {
+			// Reconstruction requires camera visibility for every input point.
+			// A plain PLY may provide geometry but no camera-view indices.
+			if (scene.pointcloud.points.IsEmpty() ||
+				scene.pointcloud.pointViews.GetSize() != scene.pointcloud.points.GetSize()) {
+				VERBOSE("error: point cloud requires per-point camera visibility");
+				return EXIT_FAILURE;
+			}
+			FOREACH(idxPoint, scene.pointcloud.pointViews) {
+				const PointCloud::ViewArr& views = scene.pointcloud.pointViews[idxPoint];
+				if (views.IsEmpty()) {
+					VERBOSE("error: point cloud requires per-point camera visibility");
+					return EXIT_FAILURE;
+				}
+				FOREACH(idxView, views) {
+					if (views[idxView] >= scene.images.GetSize() || !scene.images[views[idxView]].IsValid()) {
+						VERBOSE("error: point cloud requires per-point camera visibility");
+						return EXIT_FAILURE;
+					}
+				}
+			}
 			// reset image resolution to the original size and
 			// make sure the image neighbors are initialized before deleting the point-cloud
 			#ifdef RECMESH_USE_OPENMP
